# PostgreSQL Flexible Server en Azure
# Si la contraseña tiene caracteres especiales (@ : / # ?) codifícalos (ej. @ -> %40)
DATABASE_URL=postgresql://adminkinesia:TU_PASSWORD@TU-SERVIDOR.postgres.database.azure.com:5432/postgres
# Azure exige SSL. Pon false solo si pruebas con un PostgreSQL local
DB_SSL=true
# Validacion del certificado SSL del servidor (true por defecto). En Azure puede
# ser necesario poner false si el certificado raiz no esta en el bundle del sistema.
DB_SSL_REJECT_UNAUTHORIZED=true

# Azure Blob Storage (Cuenta de almacenamiento -> Claves de acceso -> Cadena de conexión)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=kinesia-media

# Servidor (App Service define PORT automáticamente)
PORT=3000
# true solo la primera vez (o al cambiar modelos) para crear/alterar tablas
DB_SYNC=true

# Demo local sin PostgreSQL real (datos en memoria, se pierden al reiniciar)
USE_PG_MEM=false
# Carga data/alimentos.json al arrancar. En pg-mem siempre se carga.
SEED_ALIMENTOS=false

# Origen(es) permitidos del frontend, separados por coma.
# En Azure: https://TU-STATIC-WEB-APP.azurestaticapps.net
CORS_ORIGIN=http://localhost:5173

# Proxy de estadísticas (Azure Functions)
# FUNCTIONS_URL=https://TU-FUNCTION-APP.azurewebsites.net
# FUNCTIONS_KEY=...

# Seguridad: secreto para firmar los tokens JWT (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Debe tener 32 caracteres o más y NO debe quedar como este valor de ejemplo.
JWT_SECRET=cambio_este_secreto_por_uno_propio
JWT_EXPIRES_IN=8h