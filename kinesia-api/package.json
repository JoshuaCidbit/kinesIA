{
  "name": "kinesia-api",
  "version": "3.0.0",
  "description": "KinesIA - API REST en Azure (App Service + PostgreSQL Flexible Server + Blob Storage) y Azure Functions",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "start:local": "node scripts/start-local.js",
    "dev:local": "nodemon scripts/start-local.js",
    "seed:alimentos": "node scripts/seed-alimentos.js",
    "crear-admin": "node scripts/crear-admin.js",
    "test:ag": "node --test tests/ag.test.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:api": "node --test --test-concurrency=1 tests/api-ag.test.js",
    "smoke:ag": "node tests/smoke-ag.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.25.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pg-mem": "^3.0.14"
  }
}
